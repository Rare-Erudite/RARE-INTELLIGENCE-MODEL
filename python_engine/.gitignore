# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# --- Model weights (large binaries, fetched by script) ---
# Anchored to repo root: a bare `models/` also matches rare_engine/models/.
/models/
*.gguf
*.safetensors
*.bin
*.pt
*.onnx

# --- Runtime state ---
.rare/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
logs/
runs/
artifacts/
workspace_tmp/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node (integration tooling only) ---
node_modules/
npm-debug.log*

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# The models/ dir is a local symlink to the weight store; never commit it.
# NOTE: must be anchored to the repo root. A bare `models` pattern also matches
# rare_engine/models/ (the adapter package), which silently excluded the entire
# model layer from every commit until v0.3.1. Do not un-anchor this.
/models
