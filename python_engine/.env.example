# =============================================================================
# RARE Intelligence Engine - environment template
# Copy to .env and fill in. NEVER commit the real .env.
# =============================================================================

# --- Engine core -------------------------------------------------------------
RARE_ENV=development
RARE_LOG_LEVEL=INFO
RARE_LOG_FORMAT=json
# Root for all mutable engine state (task DB, memory DB, run artifacts)
RARE_STATE_DIR=.rare
# Hard ceiling for a single task, seconds
RARE_TASK_TIMEOUT_S=900
# Hard ceiling for a single model call, seconds
RARE_MODEL_TIMEOUT_S=180

# --- Model selection ---------------------------------------------------------
# Must match a key under `models:` in config/engine.yaml
RARE_DEFAULT_MODEL=qwen3-0.6b-instruct-q4km

# --- Local inference (llama.cpp) --------------------------------------------
# Path to a GGUF file. Relative paths resolve against the repo root.
RARE_MODEL_PATH=models/Qwen3-0.6B-Q4_K_M.gguf
RARE_N_THREADS=0          # 0 = auto (min(8, cpu_count))
RARE_N_CTX=4096
RARE_N_GPU_LAYERS=0       # 0 = pure CPU

# --- Remote inference (OpenAI-compatible endpoint) ---------------------------
# Works with OpenAI, vLLM, LM Studio, Ollama (/v1), Together, Groq, etc.
RARE_OPENAI_BASE_URL=
RARE_OPENAI_API_KEY=
RARE_OPENAI_MODEL=

# --- Tools -------------------------------------------------------------------
# Comma-separated allowlist of tool names. Empty = all registered tools.
RARE_TOOL_ALLOWLIST=
# Sandbox root for filesystem tools. Nothing outside this is writable.
RARE_SANDBOX_ROOT=.rare/sandbox
# Enable the shell tool (still allowlist-gated). Keep false in production.
RARE_ENABLE_SHELL=false
RARE_SHELL_TIMEOUT_S=60

# --- Integration (NOT active in this repo) -----------------------------------
# The engine is standalone. These are documented in INTEGRATION_CONTRACT.md
# and are intentionally unused by the engine runtime.
RARE_INTEGRATION_ENABLED=false
